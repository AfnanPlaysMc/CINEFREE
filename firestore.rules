rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.id is string &&
             data.id == userId &&
             data.id == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 320 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidWatchlistItem(data, userId) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.mediaId is string &&
             data.mediaId.size() <= 64 &&
             (data.mediaType == 'movie' || data.mediaType == 'tv') &&
             data.title is string &&
             data.title.size() <= 300 &&
             data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             (!('posterPath' in data) || data.posterPath == null || (data.posterPath is string && data.posterPath.size() <= 300)) &&
             (!('backdropPath' in data) || data.backdropPath == null || (data.backdropPath is string && data.backdropPath.size() <= 300)) &&
             (!('voteAverage' in data) || data.voteAverage is number) &&
             (!('releaseDate' in data) || (data.releaseDate is string && data.releaseDate.size() <= 50)) &&
             (!('overview' in data) || (data.overview is string && data.overview.size() <= 3000)) &&
             (!('addedAt' in data) || (data.addedAt is string && data.addedAt.size() <= 50));
    }

    function isValidHistoryItem(data, userId) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.mediaId is string &&
             data.mediaId.size() <= 64 &&
             (data.mediaType == 'movie' || data.mediaType == 'tv') &&
             data.title is string &&
             data.title.size() <= 300 &&
             data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             (!('posterPath' in data) || data.posterPath == null || (data.posterPath is string && data.posterPath.size() <= 300)) &&
             (!('viewedAt' in data) || (data.viewedAt is string && data.viewedAt.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /watchlist/{itemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(itemId) && isValidWatchlistItem(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(itemId) && isValidWatchlistItem(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /history/{itemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(itemId) && isValidHistoryItem(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(itemId) && isValidHistoryItem(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
